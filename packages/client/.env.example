# Copia questo file in packages/client/.env (non committato) e compila i valori.
# Senza queste variabili il client funziona lo stesso: niente login, mazzi salvati e storico.

# Supabase → Settings → API Keys
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...): pubblica per costruzione, protetta dalle regole RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server di gioco (default: stesso host, porta 2567)
# VITE_SERVER_URL=ws://localhost:2567
