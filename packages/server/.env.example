# Copia questo file in packages/server/.env (non committato) e compila i valori.
# Senza queste variabili il server funziona lo stesso: solo ospiti e mazzi precostruiti.

# Supabase → Settings → API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...): scavalca le regole RLS. SOLO nel server, mai nel client, mai in git.
SUPABASE_SECRET_KEY=

# Porta del server Colyseus (default 2567)
# PORT=2567
