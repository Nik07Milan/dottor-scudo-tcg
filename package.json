{
  "name": "dottorscudo-tcg",
  "private": true,
  "version": "0.1.0",
  "description": "Gioco di carte multiplayer ispirato al fumetto Dottor Scudo",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "simulate": "npm run simulate --workspace=@dottorscudo/engine --",
    "botmatch": "npm run botmatch --workspace=@dottorscudo/engine --",
    "fuzz": "npm run fuzz --workspace=@dottorscudo/engine --",
    "dev:server": "npm run dev --workspace=@dottorscudo/server",
    "dev:client": "npm run dev --workspace=@dottorscudo/client",
    "e2e": "npm run e2e --workspace=@dottorscudo/client"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
